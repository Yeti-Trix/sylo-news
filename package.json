{
  "name": "sylo-news",
  "version": "0.1.0",
  "description": "News headlines for Pi coding agent — Google News RSS topics + FinancialJuice finance wire (no API keys). Ships a Sylo-only host plugin (pi.sylo) that is inert on vanilla Pi.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "LICENSE",
    "extensions",
    "skills",
    "host",
    "references",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/news/index.ts"
    ],
    "skills": [
      "./skills/news"
    ]
  },
  "pi.sylo": {
    "v": 1,
    "host": "./host/index.js",
    "id": "sylo-news"
  },
  "dependencies": {
    "typebox": "^1.1.24"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "test": "esbuild extensions/news/rss-fetch.test.mjs --bundle --platform=node --format=esm --outfile=out/rss-fetch.test.mjs --packages=external && node --test out/rss-fetch.test.mjs"
  }
}